{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["lib/*"],
      "@components/*": ["components/*"],
      "@components": ["components"],
      "@constants": ["constants"],
      "@app/*": ["app/*"],
      "@types": ["lib/types"],
      "@hooks/*": ["hooks/*"],
      "@theme": ["theme/theme.ts"]
    }
  }
}
